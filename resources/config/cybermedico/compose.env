# Development values ONLY.

# HTTP
PORT=8080

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cybermedico
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSL_MODE=disable
POSTGRES_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=${POSTGRES_SSL_MODE}

# S3 / MinIO
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=cybermedico
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Email
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_SENDER_NAME=CyberMedico
EMAIL_SENDER_ADDRESS=noreply@cybermedico.local
