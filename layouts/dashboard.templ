package layouts

import (
    "cybermedico/cmd/cybermedico/api/util"
    "cybermedico/components"
)

templ Dashboard(actions templ.Component) {
    <!DOCTYPE html>
    <html lang="en" if util.GetTheme(ctx) != "auto" { data-theme={ util.GetTheme(ctx) } }>
        @head()
        <body class="container-fluid">
            <header>
                @components.Navbar()
            </header>
            <div class="row-fluid">
                <div class="col-12 col-md-5 col-lg-1">
                    @components.Sidebar(util.GetCurrentPath(ctx), actions)
                </div>
                <div class="col-12 col-md-7 col-lg-11">
                    <main>
                        { children... }
                    </main>
                </div>
            </div>
        </body>
    </html>
}
