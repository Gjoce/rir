package html

import (
    "cybermedico/layouts"
    "cybermedico/cmd/cybermedico/api/util"
    "time"
    "fmt"
    "strconv"
    "cybermedico/components"
    "encoding/json"
)

func consultationType(consultation string) string {
	switch consultation {
	case "video":
		return "Video"
	case "written":
		return "Written"
	default:
		return consultation
	}
}

func consultationStatus(consultation string) string {
	switch consultation {
	case "pending":
		return "Pending"
	case "scheduled":
		return "Scheduled"
    case "finished":
        return "Finished"
    case "not_attended":
        return "Not attended"
	default:
		return consultation
	}
}

templ ConsultationsForm(comp templ.Component, currentType string, canViewNotAttended bool) {
    @layouts.Dashboard(nil) {
        @components.HeadingGroup(components.Config{
            Description: "View and manage your consultations. Click on a consultation to see details and take actions.",
            Breadcrumbs: []components.Breadcrumb{
                {Title: "Consultations"},
            },
        })
        <article>
            <div data-signals:type={ fmt.Sprintf("'%s'", currentType) } data-signals:page=1 style="margin-bottom: 2rem;">
                <div class="grid" style="text-align: center;">
                    <div>
                        <button 
                            data-on:click="$type = 'pending'; $page = 1; @get('/consultations')" 
                            data-class:outline="$type !== 'pending'" 
                            data-class:secondary="$type !== 'pending'" 
                            class={ templ.KV("outline secondary", currentType != "pending") }>
                            Active
                        </button>
                    </div>
                    <div>
                        <button 
                            data-on:click="$type = 'scheduled'; $page = 1; @get('/consultations')" 
                            data-class:outline="$type !== 'scheduled'" 
                            data-class:secondary="$type !== 'scheduled'" 
                            class={ templ.KV("outline secondary", currentType != "scheduled") }>
                            Scheduled
                        </button>
                    </div>
                    <div>
                        <button 
                            data-on:click="$type = 'finished'; $page = 1; @get('/consultations')" 
                            data-class:outline="$type !== 'finished'" 
                            data-class:secondary="$type !== 'finished'" 
                            class={ templ.KV("outline secondary", currentType != "finished") }>
                            Finished
                        </button>
                    </div>
                    if canViewNotAttended {
                        <div>
                            <button 
                                data-on:click="$type = 'not_attended'; $page = 1; @get('/consultations')" 
                                data-class:outline="$type !== 'not_attended'" 
                                data-class:secondary="$type !== 'not_attended'" 
                                class={ templ.KV("outline secondary", currentType != "not_attended") }>
                                    Not Attended
                            </button>
                        </div>
                    }
                </div>
            </div>
            @comp
            @components.CountdownScript()
        </article>
    }
}

templ ConsultationsSSE(consultations []Consultations, filters ConsultationFilters, pageCount int, showTimeLeft bool) {
    {{ filtersJson, _ := json.Marshal(filters)}}
    <div id="consultations-table" data-signals__ifmissing={ string(filtersJson) }>
        if len(consultations) == 0 {
            @components.MessageCard() {
                <p>No consultations</p>
            }
        } else {
            <div class="overflow-auto">
                <table class="striped" style="white-space: nowrap;">
                    <thead>
                        <tr>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th>Patient Email</th>
                            <th>Type</th>
                            <th>Urgent</th>
                            <th>Price</th>
                            <th>Created At</th>
                            if showTimeLeft {
                                <th>Time Left</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        for _, consultation := range consultations {
                            <tr data-on:click={ fmt.Sprintf("window.location='/consultations/%s'", consultation.ID)} style="cursor: pointer;">
                                <td>{ consultation.PatientName } { consultation.PatientSurname }</td>
                                <td> { consultation.DoctorDisplayName }</td>
                                <td>{ consultation.PatientEmail }</td>
                                <td>{ consultationType(consultation.ConsultationType) }</td>
                                if consultation.Urgent {
                                    <td>
                                        <span class="badge-true">Yes</span>
                                    </td>
                                } else {
                                    <td>
                                        <span class="badge-false">No</span>
                                    </td>
                                }
                                <td>{ consultation.Price } €</td>
                                <td> { consultation.CreatedAt.Format("02-01-2006") }</td>
                                 if showTimeLeft {
                                    <td>
                                        <kbd>
                                        @components.CountdownTimer(components.CountdownConfig{
                                            ExpiresAt:          consultation.ExpiresAt,
                                            VideoExpiresAt:     consultation.VideoExpiresAt,
                                            RequiresResponseBySchedule: consultation.VideoRequiresResponseBy,
                                            ConsultationID:     consultation.ID,
                                            ConsultationType:   consultation.ConsultationType,
                                            ConsultationStatus: consultation.ConsultationStatus,
                                        })
                                        </kbd>
                                    </td>
                                 }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div style="display: flex; justify-content: center; gap: 0.5rem; margin-top: 1rem; align-items: center;">
                if filters.Page > 1 {
                    <button data-on:click={ fmt.Sprintf("$page = %d; @get('/consultations')", filters.Page-1) } class="outline">
                        Previous
                    </button>
                }
                <span>Page { filters.Page } of { pageCount }</span>
                if filters.Page < pageCount {
                    <button data-on:click={ fmt.Sprintf("$page = %d; @get('/consultations')", filters.Page+1) } class="outline">
                        Next
                    </button>
                }
            </div>
            }
        </div>
}

templ ConsultationFormHtml(consultation Consultation, role string, canAnswerConsultation bool, videoCall VideoCallEntry) {
    @layouts.Dashboard(consultationActions(consultation, role, canAnswerConsultation, videoCall)) {
        @components.HeadingGroup(components.Config{
            Description: "Detailed information about the consultation, including patient details, medical information, attachments, and timestamps.",
            Breadcrumbs: []components.Breadcrumb{
                {Title: "Consultations", URL: "/consultations"},
                {Title: consultation.PatientName},
            },
            ScheduledAt: func() string {
                if consultation.ScheduledAt != nil && consultation.ConsultationStatus == "scheduled" {
                    return consultation.ScheduledAt.Format("02-01-2006 15:04")
                }
                return ""
            }(),
        })
        <article>
            if consultation.ConsultationStatus == "pending" || consultation.ConsultationStatus == "scheduled" {
                <p>
                    Time left:
                    <kbd>
                        @components.CountdownTimer(components.CountdownConfig{
                            ExpiresAt:                  consultation.ExpiresAt,
                            VideoExpiresAt:             consultation.VideoExpiresAt,
                            RequiresResponseBySchedule: consultation.VideoRequiresResponseBy,
                            ConsultationID:             consultation.ID,
                            ConsultationType:           consultation.ConsultationType,
                            ConsultationStatus:         consultation.ConsultationStatus,
                        })
                    </kbd>
                </p>
                @components.CountdownScript()
            }
            <div class="grid">
                <div>
                    @components.Input(components.InputConfig{
                        Label: "Patient name",
                        Value: consultation.PatientName,
                        Type: components.TextInput,
                        ReadOnly: true,
                    })
                    @components.Input(components.InputConfig{
                        Label: "Patient age",
                        Value: fmt.Sprintf("%d", consultation.PatientAge),
                        Type: components.NumberInput,
                        ReadOnly: true,
                    })
                    @components.Input(components.InputConfig{
                        Label: "Urgent",
                        Value: fmt.Sprintf("%t", consultation.Urgent),
                        Type: components.TextInput,
                        ReadOnly: true,
                    })
                    @components.Input(components.InputConfig{
                        Label: "Consultation type",
                        Value: consultationType(consultation.ConsultationType),
                        Type: components.TextInput,
                        ReadOnly: true,
                    })
                </div>
                <div>
                    @components.Input(components.InputConfig{
                        Label: "Patient surname",
                        Value: consultation.PatientSurname,
                        Type: components.TextInput,
                        ReadOnly: true,
                    })
                    @components.Input(components.InputConfig{
                        Label: "Patient place of living",
                        Value: util.Deref(consultation.PatientPlaceOfLiving, "/"),
                        Type: components.TextInput,
                        ReadOnly: true,
                    })
                    @components.Input(components.InputConfig{
                        Label: "Translator needed",
                        Value: fmt.Sprintf("%t", consultation.NeedTranslator),
                        Type: components.TextInput,
                        ReadOnly: true,
                    })
                    @components.Input(components.InputConfig{
                        Label: "Consultation status",
                        Value: consultationStatus(consultation.ConsultationStatus),
                        Type: components.TextInput,
                        ReadOnly: true,
                    })
                </div>
            </div>
        </article>
            @components.HeadingGroup(components.Config{
                Description: "Medical information provided by the patient during the consultation request, including symptoms, diagnosis, allergies, and medications.",
                Breadcrumbs: []components.Breadcrumb{
                    {Title: "Medical information"},
                },
            })
        <article>
            @components.TextArea(components.TextAreaConfig{
                Label: "Medical problem",
                Value: consultation.MedicalProblem,
                ReadOnly: true,
            })
            @components.TextArea(components.TextAreaConfig{
                Label: "Patient diagnosis",
                Value: util.Deref(consultation.PatientDiagnosis, "/"),
                ReadOnly: true,
            })
            @components.TextArea(components.TextAreaConfig{
                Label: "Patient allergies",
                Value: util.Deref(consultation.Allergies, "/"),
                ReadOnly: true,
            })
            @components.TextArea(components.TextAreaConfig{
                Label: "Patient medications",
                Value: util.Deref(consultation.Medication, "/"),
                ReadOnly: true,
            })
        </article>
        if len(consultation.Attachments) > 0 {
            @components.HeadingGroup(components.Config{
                Description: "Attachments related to the consultation, such as medical reports, images, or documents provided by the patient.",
                Breadcrumbs: []components.Breadcrumb{
                    {Title: "Attachments"},
                },
            })
            <article>
                <ul>
                    for _, v := range consultation.Attachments {
                        <li><a href={ templ.URL(v.URL) }>{ v.Filename }</a></li>
                    }
                </ul>
            </article>
        }
        if len(consultation.CallEvents) > 0 {
            @components.HeadingGroup(components.Config{
                Description: "What happened in the video call, in Skopje time.",
                Breadcrumbs: []components.Breadcrumb{
                    {Title: "Call log"},
                },
            })
            <article>
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Time</th>
                            <th scope="col">Event</th>
                        </tr>
                    </thead>
                    <tbody>
                        for _, e := range consultation.CallEvents {
                            <tr>
                                <td>{ e.Time }</td>
                                <td>{ e.Label }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </article>
        }
        @components.HeadingGroup(components.Config{
            Description: "Metadata about the consultation.",
            Breadcrumbs: []components.Breadcrumb{
                {Title: "Metadata"},
            },
        })
        <article>
            <div class="grid">
                <div>
                    @components.Input(components.InputConfig{
                        Label: "Created at",
                        Value: consultation.CreatedAt.Format("02-01-2006 15:04"),
                        Type: components.TextInput,
                        ReadOnly: true,
                    })
                </div>
                <div>
                    @components.Input(components.InputConfig{
                        Label: "Finished at",
                        Value: func() string {
                            if consultation.FinishedAt != nil {
                                return consultation.FinishedAt.Format("02-01-2006 15:04")
                            }
                            return "/"
                        }(),
                        Type: components.TextInput,
                        ReadOnly: true,
                    })
                </div>
            </div>
        </article>
        if consultation.ConsultationStatus == "finished" && consultation.DoctorAnswer != nil {
            @components.HeadingGroup(components.Config{
                Breadcrumbs: []components.Breadcrumb{
                    {Title: "Doctor's answer"},
                },
            })
            <article>
                @templ.Raw(*consultation.DoctorAnswer)
                <footer id="signature-status">
                    @signatureStatus(consultation.Signature)
                </footer>
            </article>
        }
    }
}

// opinionDeadlinePassed reports whether a held video call can no longer get its
// written opinion.
func opinionDeadlinePassed(c Consultation) bool {
    return c.ConsultationType == "video" && c.ConsultationStatus == "scheduled" &&
        c.VideoExpiresAt != nil && !time.Now().Before(*c.VideoExpiresAt)
}

templ signatureStatus(s SignatureStatus) {
    switch s.State {
        case "valid":
            <small>✔ Digitally signed by { s.Doctor } on { s.SignedAt }. The signature is valid.</small>
        case "pending":
            <small>The opinion is being signed.</small>
        case "invalid":
            <small><strong>✖ The signature is not valid:</strong> the opinion or the consultation data changed after signing.</small>
        default:
            <small>The signature can't be checked right now.</small>
    }
}

templ consultationActions(consultation Consultation, role string, canAnswer bool, videoCall VideoCallEntry) {
    if role == "doctor" && consultation.ConsultationStatus != "finished" {
        if consultation.ConsultationStatus == "pending" && consultation.ConsultationType == "video" {
            <ul>
                <li>
                    <a href={ templ.SafeURL(fmt.Sprintf("/consultations/%s/schedule", consultation.ID)) } role="button" class="secondary">Schedule</a>
                </li>
            </ul>
        }
        if videoCall.Show {
            <ul>
                <li>
                    // Before the window it still leads to the call page, which waits
                    // and opens the call by itself.
                    <a
                        href={ templ.URL("/consultations/" + consultation.ID + "/video") }
                        role="button"
                        if !videoCall.Open {
                            class="secondary"
                        }
                    >
                        Join video consultation
                    </a>
                </li>
                if !videoCall.Open {
                    <li><small>Opens { videoCall.OpensAt }</small></li>
                }
            </ul>
        } else if canAnswer {
            <ul>
                <li>
                    <a href={ templ.SafeURL(fmt.Sprintf("/consultations/%s/answer", consultation.ID)) } role="button" class="secondary">Write answer</a>
                </li>
                if consultation.ConsultationType == "video" && consultation.VideoExpiresAt != nil {
                    <li><small>By { util.FormatAppointmentTime(*consultation.VideoExpiresAt) }</small></li>
                }
            </ul>
        } else if opinionDeadlinePassed(consultation) {
            <ul>
                <li><small>The 24 hours for the written opinion after the call have passed.</small></li>
            </ul>
        }
    }
}

templ ScheduleConsultationForm(schedule ScheduleConsultation) {
    @layouts.Dashboard(nil) {
        @components.HeadingGroup(components.Config{
            Description: "Schedule a video consultation with the patient. Choose a date and time that works for both you and the patient.",
            Breadcrumbs: []components.Breadcrumb{
                {Title: "Consultations", URL: "/consultations"},
                {Title: schedule.PatientName, URL: fmt.Sprintf("/consultations/%s", schedule.ID)},
                {Title: "Schedule"},
            },
        })
        <article>
            <div class="overflow-auto">
                <table class="striped" style="white-space: nowrap;">
                    <thead>
                        <tr>
                            <th>Patient name</th>
                            <th>Patient surname</th>
                            <th>Patient age</th>
                            <th>Consultation type</th>
                            <th>Urgent</th>
                            <th>Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>{ schedule.PatientName }</td>
                            <td>{ schedule.PatientSurname }</td>
                            <td>{ schedule.PatientAge }</td>
                            <td>{ consultationType(schedule.ConsultationType) }</td>
                                if schedule.Urgent {
                                <td>
                                    <span class="badge-true">Yes</span>
                                </td>
                            } else {
                                <td>
                                    <span class="badge-false">No</span>
                                </td>
                            }
                            <td>{ schedule.Price }</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <p>
                Time left to schedule:
                <kbd>
                    @components.CountdownTimer(components.CountdownConfig{
                        RequiresResponseBySchedule: schedule.VideoRequiresResponseBy,
                        ConsultationID:             schedule.ID,
                        ConsultationType:           schedule.ConsultationType,
                        ConsultationStatus:         schedule.ConsultationStatus,
                    })
                </kbd>
            </p>
            @components.CountdownScript()
            @components.Input(components.InputConfig{
                Label: "Preferred time by patient",
                Value: schedule.PreferredTime,
                Type: components.TextInput,
                ReadOnly: true,
            })
            <hr/>
            <div>
                <form method="POST" action={ templ.SafeURL(fmt.Sprintf("/consultations/%s/schedule", schedule.ID)) } novalidate>
                    @components.Input(components.InputConfig{
                        Label: "Schedule date and time",
                        ID: "scheduled_at_local",
                        Type: components.DatetimeLocalInput,
                        Required: true,
                        Value: schedule.ScheduledAt,
                        Valid: schedule.ScheduledAtErr == "",
                        ValidationText: schedule.ScheduledAtErr,
                    })
                    @components.HiddenInput("date", "")
                    <button type="submit">Schedule</button>
                </form>
                <script>
                    document.querySelector('form').addEventListener('submit', function() {
                        const value = document.getElementById('scheduled_at_local').value;
                        document.getElementById('date').value = value ? new Date(value).toISOString() : '';
                    });
                </script>
            </div>
        </article>
    }
}

templ answerConsultationModal(consultationID string, totp answerConsultationTOTP) {
    <dialog
        id="answer-consultation-dialog"
        open?={ totp.TOTPCodeErr != "" }
    >
        <article>
            <header>
                <button
                    aria-label="close"
                    class="close"
                    data-on:click="document.getElementById('answer-consultation-dialog').close()"
                />
                <strong>Enter TOTP code</strong>
            </header>
             <div>
                <form data-on:submit={ fmt.Sprintf("@post('/consultations/%s/answer');", consultationID) } novalidate>
                    @components.Input(components.InputConfig{
                        Type: components.TextInput,
                        Name: "totp_code",
                        Label: "Authentication Code (from your authenticator app)",
                        Placeholder: "000000",
                        Required: true,
                        Valid: totp.TOTPCodeErr == "",
                        ValidationText: totp.TOTPCodeErr,
                    })
                    <button type="submit">Submit answer</button>
                </form>
            </div>
        </article>
    </dialog>
}

templ answerError(err string) {
    <div id="answer-error">
        if err != "" {
            <input type="hidden"
                aria-invalid="true"
            />
            <small>{ err }</small>
        }
    </div>
}

templ ConsultationAnswerForm(consultation answerConsultation, totp answerConsultationTOTP) {
    @layouts.Dashboard(nil) {
        @components.HeadingGroup(components.Config{
            Description: "Provide an answer to the patient's consultation request. Write a detailed response based on the patient's symptoms and medical information.",
            Breadcrumbs: []components.Breadcrumb {
                {Title: "Consultations", URL: "/consultations"},
                {Title: consultation.PatientName, URL: fmt.Sprintf("/consultations/%s", consultation.ID)},
                {Title: "Answer"},
            },
        })
        <article>
            <div class="overflow-auto">
                <table class="striped" style="white-space: nowrap;">
                    <thead>
                        <tr>
                            <th>Patient name</th>
                            <th>Patient surname</th>
                            <th>Patient age</th>
                            <th>Consultation type</th>
                            <th>Urgent</th>
                            <th>Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>{ consultation.PatientName }</td>
                            <td>{ consultation.PatientSurname }</td>
                            <td>{ strconv.Itoa(consultation.PatientAge) }</td> 
                            <td>{ consultationType(consultation.ConsultationType) }</td>
                                if consultation.Urgent {
                                <td>
                                    <span class="badge-true">Yes</span>
                                </td>
                            } else {
                                <td>
                                    <span class="badge-false">No</span>
                                </td>
                            }
                            <td>{ consultation.Price }</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <hr/>
            <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet"/>
            <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
            @components.Quill(components.QuillConfig{
                Label: "Answer",
                Required: true,
                Placeholder: "Based on your provided symptoms...",
                Name: "answer",
                Height: 200,
                Value: consultation.Answer,
                Valid: consultation.AnswerErr == "",
                ValidationText: consultation.AnswerErr,
            })
            @answerError(consultation.AnswerErr)
            <button type="submit" data-on:click="document.getElementById('answer-consultation-dialog').showModal()">Submit</button>
            @answerConsultationModal(consultation.ID, totp)
        </article>
    }
}
