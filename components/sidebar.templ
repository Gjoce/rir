package components

import "cybermedico/cmd/cybermedico/api/util"

templ Sidebar(currentPath string, actions templ.Component) {
	<article>
		<aside>
			<nav>
				<ul>
					<li>Panel</li>
				</ul>
				<ul>
					<li><span class="nav-section-label">Overview</span></li>
					<li>
						<a
							href="/dashboard"
							class={ util.ClassIfActive(currentPath, "/dashboard") }
							role={ util.RoleIfActive(currentPath, "/dashboard") }
						>
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<rect width="7" height="9" x="3" y="3" rx="1"></rect>
								<rect width="7" height="5" x="14" y="3" rx="1"></rect>
								<rect width="7" height="9" x="14" y="12" rx="1"></rect>
								<rect width="7" height="5" x="3" y="16" rx="1"></rect>
							</svg>
							Dashboard
						</a>
					</li>
				</ul>
				// Only hides the link; DoctorsHandler checks the Rego policy itself.
				if util.GetRole(ctx) == "admin" {
					<ul>
						<li><span class="nav-section-label">Management</span></li>
						<li>
							<a
								href="/doctors"
								class={ util.ClassIfActive(currentPath, "/doctors") }
								role={ util.RoleIfActive(currentPath, "/doctors") }
							>
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
									<circle cx="9" cy="7" r="4"></circle>
									<path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
									<path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
								</svg>
								Doctors
							</a>
						</li>
					</ul>
				}
				<ul>
					<li><span class="nav-section-label">Content</span></li>
					<li>
						<a
							href="/consultations"
							class={ util.ClassIfActive(currentPath, "/consultations") }
							role={ util.RoleIfActive(currentPath, "/consultations") }
						>
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
								<line x1="16" y1="2" x2="16" y2="6"></line>
								<line x1="8" y1="2" x2="8" y2="6"></line>
								<line x1="3" y1="10" x2="21" y2="10"></line>
								<path d="M9 16l2 2 4-4"></path>
							</svg>
							Consultations
						</a>
					</li>
				</ul>
				<hr class="custom"/>
				if actions != nil {
					@actions
				}
			</nav>
		</aside>
	</article>
}
